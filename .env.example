# AI Code Guardian - environment template
# Copy to .env and fill in values you need. NEVER commit .env.

# Server (Fixed Rule 6: 127.0.0.1 only)
HOST=127.0.0.1
PORT=8000

# AI Explainer (STEP 6). Tool works WITHOUT these (fallback mode).
# Provider: groq | gemini | none. If unset, auto-detected from keys below.
# AI_PROVIDER=none

# Groq (free tier): https://console.groq.com/keys
# GROQ_API_KEY=

# Google Gemini (free tier): https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# Optional overrides
# AI_MODEL=
# AI_TIMEOUT_SECONDS=30